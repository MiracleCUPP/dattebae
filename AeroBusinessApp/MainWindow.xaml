<Window x:Class="AeroBusinessApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroBusiness — приложение"
        Height="520"
        Width="900"
        MinHeight="420"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Icon="/AeroBusinessApp;component/Resources/app.ico">
    <Grid Background="#FFF7F7F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF6EE381">
            <Image Width="44"
                   Height="44"
                   HorizontalAlignment="Left"
                   Margin="12,8,0,8"
                   Source="/AeroBusinessApp;component/Resources/logo.png"/>

            <TextBlock Text="AeroBusiness"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="68,0,0,0"/>

            <Button x:Name="BackButton"
                    Content="Назад"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Click="BackButton_Click"/>
        </Grid>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               ContentRendered="MainFrame_ContentRendered"/>
    </Grid>
</Window>

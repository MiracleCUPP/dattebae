<Page x:Class="AeroBusinessApp.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация"
      Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1"
                Background="White"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="45"
                Margin="20"
                VerticalAlignment="Center">
            <StackPanel>
                <Image Width="90"
                       Height="90"
                       Margin="0,0,0,18"
                       Source="/AeroBusinessApp;component/Resources/logo.png"/>

                <TextBlock Text="Авторизация"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginTextBox"
                         TabIndex="1"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordInput"
                             TabIndex="2"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button x:Name="EnterGuestButton"
                            Content="Войти как гость"
                            Width="145"
                            TabIndex="3"
                            Click="EnterGuestButton_Click"/>
                    <Button x:Name="EnterButton"
                            Content="Войти"
                            Width="100"
                            TabIndex="4"
                            Click="EnterButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
